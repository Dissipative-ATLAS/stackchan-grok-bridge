{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "stackchan-grok-bridge",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-24",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      { "name": "MAILBOX", "class_name": "CallbackMailbox" }
    ]
  },
  "exports": {
    "CallbackMailbox": { "type": "durable-object", "storage": "sqlite" }
  },
  "observability": { "enabled": false }
  // Configure RELAY_MASTER_TOKEN with Wrangler's secret command; never add it here.
}
